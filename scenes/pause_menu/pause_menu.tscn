[node name="Center" type="CenterContainer" parent="Root"]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2

[node name="Items" type="VBoxContainer" parent="Root/Center"]
layout_mode = 2
theme_override_constants/separation = 16

[node name="Title" type="Label" parent="Root/Center/Items"]
layout_mode = 2
theme_override_font_sizes/font_size = 56
text = "Paused"
horizontal_alignment = 1

[node name="ResumeButton" type="Button" parent="Root/Center/Items"]
unique_name_in_owner = true
