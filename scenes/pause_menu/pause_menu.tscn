[gd_scene format=3]

[ext_resource type="Script" path="res://scenes/pause_menu/pause_menu.gd" id="1_pause"]
[ext_resource type="FontFile" uid="uid://bjqcqudoiecha" path="res://assets/fonts/Silkscreen-Regular.ttf" id="2_font"]
[ext_resource type="PackedScene" path="res://scenes/settings_menu/settings_menu.tscn" id="3_settings"]

[sub_resource type="Theme" id="Theme_pause"]
default_font = ExtResource("2_font")
default_font_size = 28

[node name="PauseMenu" type="CanvasLayer"]
process_mode = 3
layer = 10
script = ExtResource("1_pause")

[node name="Root" type="Control" parent="."]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
