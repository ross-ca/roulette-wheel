[gd_scene format=3]

[ext_resource type="Script" path="res://scenes/settings_menu/settings_menu.gd" id="1_settings"]

[node name="SettingsMenu" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("1_settings")

[node name="Center" type="CenterContainer" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2

[node name="Items" type="VBoxContainer" parent="Center"]
layout_mode = 2
theme_override_constants/separation = 24

[node name="Title" type="Label" parent="Center/Items"]
layout_mode = 2
theme_override_font_sizes/font_size = 56
text = "Settings"
horizontal_alignment = 1

[node name="Grid" type="GridContainer" parent="Center/Items"]
layout_mode = 2
theme_override_constants/h_separation = 32
theme_override_constants/v_separation = 16
columns = 2

[node name="MasterLabel" type="Label" parent="Center/Items/Grid"]
layout_mode = 2
text = "Master volume"

[node name="MasterSlider" type="HSlider" parent="Center/Items/Grid"]
unique_name_in_owner = true
custom_minimum_size = Vector2(400, 0)
layout_mode = 2
size_flags_vertical = 4
max_value = 1.0
step = 0.01

[node name="MusicLabel" type="Label" parent="Center/Items/Grid"]
layout_mode = 2
text = "Music volume"

[node name="MusicSlider" type="HSlider" parent="Center/Items/Grid"]
unique_name_in_owner = true
custom_minimum_size = Vector2(400, 0)
layout_mode = 2
size_flags_vertical = 4
max_value = 1.0
step = 0.01

[node name="SfxLabel" type="Label" parent="Center/Items/Grid"]
layout_mode = 2
text = "Effects volume"

[node name="SfxSlider" type="HSlider" parent="Center/Items/Grid"]
unique_name_in_owner = true
custom_minimum_size = Vector2(400, 0)
layout_mode = 2
size_flags_vertical = 4
max_value = 1.0
step = 0.01

[node name="WindowModeLabel" type="Label" parent="Center/Items/Grid"]
layout_mode = 2
text = "Display mode"

[node name="WindowModeOption" type="OptionButton" parent="Center/Items/Grid"]
unique_name_in_owner = true
layout_mode = 2

[node name="WindowSizeLabel" type="Label" parent="Center/Items/Grid"]
layout_mode = 2
text = "Window size"

[node name="WindowSizeOption" type="OptionButton" parent="Center/Items/Grid"]
unique_name_in_owner = true
layout_mode = 2

[node name="VsyncLabel" type="Label" parent="Center/Items/Grid"]
layout_mode = 2
text = "VSync"

[node name="VsyncCheck" type="CheckBox" parent="Center/Items/Grid"]
unique_name_in_owner = true
layout_mode = 2

[node name="AnimationSpeedLabel" type="Label" parent="Center/Items/Grid"]
layout_mode = 2
text = "Animation speed"

[node name="AnimationSpeed" type="HBoxContainer" parent="Center/Items/Grid"]
layout_mode = 2
theme_override_constants/separation = 16

[node name="AnimationSpeedSlider" type="HSlider" parent="Center/Items/Grid/AnimationSpeed"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3
size_flags_vertical = 4
max_value = 2.0
rounded = true
tick_count = 3
ticks_on_borders = true

[node name="AnimationSpeedValue" type="Label" parent="Center/Items/Grid/AnimationSpeed"]
unique_name_in_owner = true
custom_minimum_size = Vector2(64, 0)
layout_mode = 2
text = "1x"
horizontal_alignment = 2

[node name="BackButton" type="Button" parent="Center/Items"]
layout_mode = 2
text = "Back"

[connection signal="value_changed" from="Center/Items/Grid/MasterSlider" to="." method="_on_master_slider_value_changed"]
[connection signal="value_changed" from="Center/Items/Grid/MusicSlider" to="." method="_on_music_slider_value_changed"]
[connection signal="value_changed" from="Center/Items/Grid/SfxSlider" to="." method="_on_sfx_slider_value_changed"]
[connection signal="item_selected" from="Center/Items/Grid/WindowModeOption" to="." method="_on_window_mode_option_item_selected"]
[connection signal="item_selected" from="Center/Items/Grid/WindowSizeOption" to="." method="_on_window_size_option_item_selected"]
[connection signal="toggled" from="Center/Items/Grid/VsyncCheck" to="." method="_on_vsync_check_toggled"]
[connection signal="value_changed" from="Center/Items/Grid/AnimationSpeed/AnimationSpeedSlider" to="." method="_on_animation_speed_slider_value_changed"]
[connection signal="pressed" from="Center/Items/BackButton" to="." method="_on_back_button_pressed"]
