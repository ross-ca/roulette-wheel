[gd_scene format=3]

[ext_resource type="Script" path="res://scenes/shop/shop.gd" id="1_shop"]
[ext_resource type="FontFile" uid="uid://bjqcqudoiecha" path="res://assets/fonts/Silkscreen-Regular.ttf" id="2_font"]

[ext_resource type="PackedScene" path="res://scenes/card_container/card_container.tscn" id="3_cards"]

[sub_resource type="Theme" id="Theme_shop"]
default_font = ExtResource("2_font")
default_font_size = 28

[node name="Shop" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
theme = SubResource("Theme_shop")
script = ExtResource("1_shop")

[node name="Center" type="CenterContainer" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2

[node name="Items" type="VBoxContainer" parent="Center"]
layout_mode = 2
theme_override_constants/separation = 16

[node name="Title" type="Label" parent="Center/Items"]
layout_mode = 2
theme_override_font_sizes/font_size = 56
text = "Shop"
horizontal_alignment = 1

[node name="MoneyLabel" type="Label" parent="Center/Items"]
unique_name_in_owner = true
layout_mode = 2
horizontal_alignment = 1

[node name="Stock" parent="Center/Items" instance=ExtResource("3_cards")]
unique_name_in_owner = true
layout_mode = 2

[node name="TicketsLabel" type="Label" parent="Center/Items"]
unique_name_in_owner = true
layout_mode = 2
horizontal_alignment = 1

[node name="RerollButton" type="Button" parent="Center/Items"]
unique_name_in_owner = true
layout_mode = 2

[node name="ReverseButton" type="Button" parent="Center/Items"]
layout_mode = 2
text = "Reverse ticket order"

[node name="ContinueButton" type="Button" parent="Center/Items"]
layout_mode = 2
text = "Continue"

[connection signal="pressed" from="Center/Items/RerollButton" to="." method="_on_reroll_button_pressed"]
[connection signal="pressed" from="Center/Items/ReverseButton" to="." method="_on_reverse_button_pressed"]
[connection signal="pressed" from="Center/Items/ContinueButton" to="." method="_on_continue_button_pressed"]
